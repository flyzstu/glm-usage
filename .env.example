# 复制成 .env 后填写。裸机 run.sh 和 docker-compose 都会读取这个文件。

# 必填：登录 bigmodel.cn 后，浏览器 F12 → Application → Cookies → 复制
# bigmodel_token_production 的值（JWT，无需加 Bearer 前缀）
BIGMODEL_TOKEN=

# 可选：把 token 放在文件里（每行一个值即可）。文件 mtime 变化时自动重载，
# 换 token 不用重启服务。
# BIGMODEL_TOKEN_FILE=/etc/glm-usage/token

# 可选：给本服务自身加一把钥匙，客户端需带 X-API-Key 请求头
# GLM_USAGE_API_KEY=

# 监听地址 / 端口 / 进程数
GLM_USAGE_HOST=0.0.0.0
GLM_USAGE_PORT=8000
GLM_USAGE_WORKERS=1

# 上游 HTTP 行为
GLM_USAGE_REQUEST_TIMEOUT=15
GLM_USAGE_CONNECT_TIMEOUT=5
GLM_USAGE_MAX_CONNECTIONS=32
GLM_USAGE_MAX_KEEPALIVE_CONNECTIONS=16
GLM_USAGE_RETRIES=2

# 缓存（秒）。文档建议对上游的采集间隔 >= 60s（站点有 WAF），所以 quota 默认 60s；
# usage/activity/performance 是按天聚合的数据，account 更是很少变。
GLM_USAGE_QUOTA_TTL=60
GLM_USAGE_USAGE_TTL=300
GLM_USAGE_ACTIVITY_TTL=300
GLM_USAGE_PERFORMANCE_TTL=300
GLM_USAGE_ACCOUNT_TTL=3600

# 上游故障时旧值还能用多久。设短一点：宁可报错，也别把 10 分钟前的数字当现在。
GLM_USAGE_STALE_TTL=600

# 同一把 key 两次 ?refresh=1 之间的最小间隔（秒）；0 = 不限制。
# 强制刷新会绕过缓存，没有这个闸门的话一个 while 循环就能把上游打穿。
GLM_USAGE_REFRESH_MIN_INTERVAL=30

# 默认查询窗口
GLM_USAGE_DEFAULT_USAGE_DAYS=7
GLM_USAGE_DEFAULT_ACTIVITY_DAYS=30
GLM_USAGE_DASHBOARD_REFRESH_SECONDS=30

# 面板路径（故意不放在根路径，方便在反代/中间件里按路径加授权；/ 会 302 到这里）
GLM_USAGE_DASHBOARD_PATH=/dashboard

# /api/v1/summary 接受的缓存最大年龄（秒）：超过就重新取，取不到就报错，
# 而不是把很旧的数字当当前值返回。可用 ?maxAge= 逐次覆盖。
GLM_USAGE_SUMMARY_MAX_AGE=300
